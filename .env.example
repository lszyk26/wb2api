# ============================================================
# WorkBuddy 2.0 配置示例
# 复制成 .env 后按需填写；deploy/install.sh 会自动生成随机密钥
# ============================================================

# ---------- 基础 ----------
# 时区：日额度按本地 0 点重置（容器内默认 UTC）
TZ=Asia/Shanghai
# 监听地址（容器内请用 0.0.0.0:8078）
WB2_LISTEN=0.0.0.0:8078
# 对外地址：邀请链接 / 支付回调 / 邮件页脚 / CORS 默认值都来自这里
WB2_PUBLIC_URL=https://api.example.com
# 数据目录（SQLite、hub 挂载点都在里面）
WB2_DATA_DIR=/data
# 前端产物目录；留空则只提供 API（由 nginx 托管前端）
WB2_STATIC_DIR=/app/dist

# ---------- 安全（不填会随机生成，重启即失效 / 旧数据解不开）----------
# 登录令牌签名密钥，随便一串 48 位以上随机字符
WB2_JWT_SECRET=
# 账号凭据加密密钥；一旦有账号入库就不要再改
WB2_ENC_KEY=

# ---------- 管理员（首次启动建号，之后改库里）----------
WB2_ADMIN_USER=admin
# 不填则随机生成并打印到日志
WB2_ADMIN_PASS=

# ---------- 上游账号池网关（必填，否则加不了账号、接口全 502）----------
# docker compose 部署用服务名：http://hub:8788
# 裸机 / 手动起 hub 时改成 http://127.0.0.1:8788
WB2_UPSTREAM=http://hub:8788
WB2_UPSTREAM_KEY=
# 上游账号目录 + usage.jsonl 的父目录（容器里通常挂上来）
WB2_HUB_DIR=/hub
# 用量文件路径，默认 $WB2_HUB_DIR/usage/usage.jsonl
# WB2_USAGE_PATH=/hub/usage/usage.jsonl
# 优选出口槽位，逗号分隔，如 slot-11,slot-3
# WB2_PREF_SLOTS=
# hub 面板密码（docker-compose 会传给 hub 的 --panel-password，也是面板登录密码）
# 不填则默认 admin —— 公网可见前必须改；不配则本站「OAuth 一键授权」不可用
# WB2_HUB_PANEL_PASS=

# ---------- 发信：Resend 优先，SMTP 兜底 ----------
# 两个都不配 → 关闭邮箱验证码（注册直接放行）
WB2_RESEND_KEY=
WB2_RESEND_FROM=WorkBuddy2 API <noreply@example.com>
# WB2_SMTP_HOST=smtp.example.com
# WB2_SMTP_PORT=587
# WB2_SMTP_USER=
# WB2_SMTP_PASS=
# WB2_SMTP_FROM=

# ---------- GitHub OAuth 登录（不填则隐藏入口）----------
# 回调地址默认 $WB2_PUBLIC_URL/api/auth/github/callback
# WB2_GH_ID=
# WB2_GH_SECRET=
# WB2_GH_REDIRECT=

# ---------- 运营参数 ----------
# 1 元 = 多少点
# WB2_POINT_PER_YUAN=1000
# 注册礼包点数与天数
# WB2_SIGNUP_POINTS=3000
# WB2_SIGNUP_DAYS=7

# ---------- 支付（不填就只能手动转账 + 管理台确认）----------
# 回调地址默认 $WB2_PUBLIC_URL/api/pay/notify/<通道code>
# WB2_PAY_NOTIFY_BASE=
# 支付宝主通道（epay 协议）
# WB2_PAY_ALIPAY_URL=
# WB2_PAY_ALIPAY_PID=
# WB2_PAY_ALIPAY_KEY=
# 支付宝备用（epay 协议）
# WB2_PAY_ALIPAY2_URL=
# WB2_PAY_ALIPAY2_PID=
# WB2_PAY_ALIPAY2_KEY=
# 微信（epay 协议）
# WB2_PAY_WECHAT_URL=
# WB2_PAY_WECHAT_PID=
# WB2_PAY_WECHAT_KEY=
