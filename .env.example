# ============================================================
# WorkBuddy 2.0 — configuration example
# Copy to .env and edit. deploy/install.sh generates this for you.
# Full reference: README.md
# ============================================================

# ---------- Basics ----------
# Timezone: daily quotas reset at local midnight (containers default to UTC)
TZ=Asia/Shanghai
# Listen address (use 0.0.0.0:8078 inside containers)
WB2_LISTEN=0.0.0.0:8078
# Public URL: invite links, payment callbacks, email footers and default CORS all use it
WB2_PUBLIC_URL=https://api.example.com
# Data directory (SQLite, uploads, hub mount point)
WB2_DATA_DIR=/data
# Built frontend directory; leave empty to serve the API only (nginx serves the UI)
WB2_STATIC_DIR=/app/dist

# ---------- Security (random if empty, but then logins die on restart / old data becomes unreadable) ----------
# Session token signing key: any 48+ random characters
WB2_JWT_SECRET=
# Credential encryption key; never change it once accounts are stored
WB2_ENC_KEY=

# ---------- Admin (created on first boot; edit in the DB afterwards) ----------
WB2_ADMIN_USER=admin
# Empty means a random password is generated and printed to the log
WB2_ADMIN_PASS=

# ---------- Upstream account hub (required: no hub, no accounts, /v1 -> 502) ----------
# Inside docker compose use the service name; on bare metal use http://127.0.0.1:8788
WB2_UPSTREAM=http://hub:8788
# Must match the hub's API_KEY
WB2_UPSTREAM_KEY=
# Parent directory of the hub's accounts/ and usage/ (mounted into the container)
WB2_HUB_DIR=/hub
# Usage file, defaults to $WB2_HUB_DIR/usage/usage.jsonl
# WB2_USAGE_PATH=/hub/usage/usage.jsonl
# Preferred egress slots, comma separated, e.g. slot-11,slot-3
# WB2_PREF_SLOTS=
# Hub panel password (compose passes it to the hub's --panel-password; also the panel login)
# Defaults to "admin" if unset — change it before exposing the panel. Without it, OAuth one-click is unavailable.
# WB2_HUB_PANEL_PASS=

# ---------- Email: Resend first, SMTP fallback ----------
# With neither configured, email verification is disabled (signup passes through)
WB2_RESEND_KEY=
WB2_RESEND_FROM=WorkBuddy2 API <noreply@example.com>
# WB2_SMTP_HOST=smtp.example.com
# WB2_SMTP_PORT=587
# WB2_SMTP_USER=
# WB2_SMTP_PASS=
# WB2_SMTP_FROM=

# ---------- GitHub OAuth login (unset hides the entry) ----------
# Callback defaults to $WB2_PUBLIC_URL/api/auth/github/callback
# WB2_GH_ID=
# WB2_GH_SECRET=
# WB2_GH_REDIRECT=

# ---------- Business parameters ----------
# How many points one yuan buys
# WB2_POINT_PER_YUAN=1000
# Signup bonus points and how many days the newbie daily quota lasts
# WB2_SIGNUP_POINTS=3000
# WB2_SIGNUP_DAYS=7

# ---------- Payments (unset means manual transfer + admin confirmation only) ----------
# Callback defaults to $WB2_PUBLIC_URL/api/pay/notify/<channel code>
# WB2_PAY_NOTIFY_BASE=
# Alipay primary (epay protocol)
# WB2_PAY_ALIPAY_URL=
# WB2_PAY_ALIPAY_PID=
# WB2_PAY_ALIPAY_KEY=
# Alipay backup (epay protocol)
# WB2_PAY_ALIPAY2_URL=
# WB2_PAY_ALIPAY2_PID=
# WB2_PAY_ALIPAY2_KEY=
# WeChat Pay (epay protocol)
# WB2_PAY_WECHAT_URL=
# WB2_PAY_WECHAT_PID=
# WB2_PAY_WECHAT_KEY=
