[Unit]
Description=WorkBuddy 2.0 API (wb2api)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adjust to your install path
WorkingDirectory=/opt/wb2api
ExecStart=/opt/wb2api/bin/wb2api
# Config: /opt/wb2api/.env (or point WB2_ENV_FILE elsewhere)
Environment=WB2_DATA_DIR=/opt/wb2api/data
Environment=WB2_STATIC_DIR=/opt/wb2api/dist
Environment=WB2_LISTEN=127.0.0.1:8078
EnvironmentFile=-/opt/wb2api/.env
Restart=always
RestartSec=3
LimitNOFILE=65535
# No timeouts: /v1 responses stream for a long time
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/wb2api/data /opt/wb2api/hub

[Install]
WantedBy=multi-user.target
